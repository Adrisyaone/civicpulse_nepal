# Supabase (get from https://supabase.com)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Apps Script Web App URL (from deployment)
VITE_SHEETS_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Google Drive folder IDs
VITE_DRIVE_PHOTOS_FOLDER_ID=your-photos-folder-id

# GAS Script Properties (set inside Apps Script — never in frontend):
# SPREADSHEET_ID = your-sheet-id
# DRIVE_ROOT_FOLDER_ID = your-drive-folder-id
# GEMINI_API_KEY = AIza... (free from https://aistudio.google.com/app/apikey)
